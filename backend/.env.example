# Copie este arquivo para backend/.env e preencha os valores.
# O arquivo .env NÃO vai para o repositório (está no .gitignore).

FLASK_DEBUG=True

# Chave secreta do Flask. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Banco de dados. Sem esta linha, o projeto usa SQLite em backend/instance/rotamais.db.
# DATABASE_URL=sqlite:///caminho/para/outro.db
